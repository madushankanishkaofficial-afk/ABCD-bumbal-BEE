# Copy this file to .env and change the values before running.
PORT=3000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
DB_FILE=./data/exora.sqlite
UPLOAD_DIR=./uploads

# First admin is created from these values when the database is initialized.
ADMIN_NAME=Exora Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe_12345!_before_deploy

# Optional Telegram order alerts. Keep these server-only; never add to public JS.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Store contact settings
STORE_NAME=Exora
STORE_CURRENCY=LKR
STORE_SUPPORT_EMAIL=support@example.com
PUBLIC_BASE_URL=https://YOUR-DOMAIN.store

# Firebase client configuration (public browser settings; configure Auth providers in Firebase Console)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
# Firebase Admin SDK service account for server-side ID-token verification (keep private; never upload to GitHub)
FIREBASE_SERVICE_ACCOUNT_PATH=
# Instead of a path, you may set FIREBASE_SERVICE_ACCOUNT_JSON_BASE64= to a Base64-encoded service-account JSON string.
FREE_SHIPPING_THRESHOLD=15000
DEFAULT_DELIVERY_FEE=450
TRUST_PROXY=0
